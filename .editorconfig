root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,vsixmanifest,json,slnx}]
indent_size = 2

[*.{bat,cmd,ps1,psm1,psd1}]
end_of_line = crlf

# Windows PowerShell 5.1 は BOM の無いスクリプトを Shift-JIS として読む(.github/scripts/bom_policy.py と揃える)
[*.{ps1,psm1,psd1}]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false
