root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml,vsixmanifest,json,slnx}]
indent_size = 2

[*.{bat,cmd,ps1,psm1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
